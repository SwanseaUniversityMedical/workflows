{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    ":enableRenovate"
  ],
  "schedule": [
    "* * * * *"
  ],
  "customManagers": [
    {
      "customType": "regex",
      "managerFilePatterns": [
        "/^\\.github/actions/kubeconform/action\\.yaml$/"
      ],
      "matchStrings": [
        "# renovate: datasource=(?<datasource>[a-z-]+?) depName=(?<depName>\\S+?)\\s+KUBECONFORM_VERSION='(?<currentValue>[^']+)'",
        "# renovate: datasource=(?<datasource>[a-z-]+?) depName=(?<depName>\\S+?) branch=(?<currentValue>\\S+)\\s+\\w+='(?<currentDigest>[0-9a-f]{40})'"
      ]
    }
  ]
}
